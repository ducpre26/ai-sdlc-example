{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-first-sdlc/artifact-metadata.schema.json",
  "title": "Metadata tài liệu AI-First SDLC",
  "type": "object",
  "required": [
    "document_id",
    "document_type",
    "project",
    "version",
    "supersedes_version",
    "status",
    "previous_status",
    "owner",
    "approver",
    "created_at",
    "updated_at",
    "source_documents",
    "related_documents",
    "related_work_items",
    "evidence",
    "open_questions",
    "ai_generated",
    "ai_checked_at",
    "human_decision",
    "human_approved_at"
  ],
  "properties": {
    "document_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "document_type": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "project": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "supersedes_version": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        {"type": "null"}
      ]
    },
    "status": {"enum": ["draft", "ai_checked", "human_review", "approved", "superseded"]},
    "previous_status": {"enum": [null, "draft", "ai_checked", "human_review", "approved"]},
    "owner": {"type": "string", "minLength": 1},
    "approver": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date"},
    "updated_at": {"type": "string", "format": "date"},
    "source_documents": {"type": "array", "items": {"type": "string"}},
    "related_documents": {"type": "array", "items": {"type": "string"}},
    "related_work_items": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "ai_generated": {"type": "boolean"},
    "ai_checked_at": {"type": ["string", "null"], "format": "date"},
    "human_decision": {"enum": [null, "approved", "conditional", "rejected"]},
    "human_approved_at": {"type": ["string", "null"], "format": "date"}
  },
  "additionalProperties": true
}
